{
  "name": "pandoc-excalidraw",
  "version": "0.1.0",
  "description": "Pandoc filter that renders Excalidraw diagrams to PNG or SVG",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "bin": {
    "pandoc-excalidraw": "./bin/pandoc-excalidraw.js"
  },
  "main": "./dist/filter.js",
  "scripts": {
    "ensure-tsc": "node -e \"const fs=require('fs'); if (!fs.existsSync('./node_modules/typescript/bin/tsc')) process.exit(1);\" || npm install --no-save --ignore-scripts typescript@^5",
    "build": "npm run ensure-tsc && node ./node_modules/typescript/bin/tsc",
    "test": "jest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@excalidraw/utils": "0.1.3-test32",
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^25.0.0",
    "pandoc-filter": "^2.2.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
